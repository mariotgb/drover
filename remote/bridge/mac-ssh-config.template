# Generated by `install.sh ssh-config` from this template. For the AGENTS running on the Mac.
#
# Activate it with ONE line at the very top of ~/.ssh/config (you do that yourself):
#
#     Include "/ABSOLUTE/PATH/TO/remote/bridge/mac-ssh-config"
#
# Then:  ssh pc   /   ssh homeserver
# The first connection to each machine must be made by a human, who checks the
# host key (StrictHostKeyChecking yes, so unattended agents never auto-trust).
# NOTE: `Host pc` / `Host homeserver` here win over same-named hosts further down your config.

Host drover-vps
    HostName __VPS_HOST__
    Port __VPS_PORT__
    # Restricted user: forwarding to the PC/home server ports only, no shell.
    User jump
    IdentityFile ~/.ssh/agents_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/mac_bridge_known_hosts
    StrictHostKeyChecking yes
    ServerAliveInterval 30
    ServerAliveCountMax 3

# Windows 10/11 PC (default shell: PowerShell). VPS 127.0.0.1:2223.
Host pc
    HostName 127.0.0.1
    Port 2223
    User agent
    ProxyJump drover-vps
    IdentityFile ~/.ssh/agents_ed25519
    IdentitiesOnly yes
    HostKeyAlias drover-pc
    UserKnownHostsFile ~/.ssh/drover_known_hosts
    StrictHostKeyChecking yes
    ServerAliveInterval 30
    ControlMaster auto
    ControlPath ~/.ssh/cm-drover-%C
    ControlPersist 10m

# Home server (Linux, bash, passwordless sudo). VPS 127.0.0.1:2224.
Host homeserver
    HostName 127.0.0.1
    Port 2224
    User agent
    ProxyJump drover-vps
    IdentityFile ~/.ssh/agents_ed25519
    IdentitiesOnly yes
    HostKeyAlias drover-home
    UserKnownHostsFile ~/.ssh/drover_known_hosts
    StrictHostKeyChecking yes
    ServerAliveInterval 30
    ControlMaster auto
    ControlPath ~/.ssh/cm-drover-%C
    ControlPersist 10m
